<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AI Usage Monitor</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.3.2</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ClaudeDesktopAuth.cs;ClaudeConnectionChecks.cs" />
    <EmbeddedResource Include="Assets\AppIcon.ico" LogicalName="AppIcon.ico" />
    <EmbeddedResource Include="Assets\Gpt.png" LogicalName="GptLogo.png" />
    <EmbeddedResource Include="Assets\Claude.png" LogicalName="ClaudeLogo.png" />
    <EmbeddedResource Include="Assets\Gemini.png" LogicalName="GeminiLogo.png" />
    <EmbeddedResource Include="Assets\DuckWalkSheet.png" LogicalName="DuckWalkSheet.png" />
    <EmbeddedResource Include="Assets\ChubbyBabyPenguin.gif" LogicalName="ChubbyBabyPenguin.gif" />
    <EmbeddedResource Include="Assets\BabyPenguin.gif" LogicalName="BabyPenguin.gif" />
    <EmbeddedResource Include="Assets\SquidHatPenguin.gif" LogicalName="SquidHatPenguin.gif" />
  </ItemGroup>
</Project>
